{
  "name": "ti3d-editor",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "npm run audit && npm run typecheck && npm run build",
    "audit": "node scripts/project-audit.mjs",
    "test:mesh-construction": "node ./scripts/run-static-mesh-construction-test.mjs",
    "test:mesh-construction:raw": "node --loader ./scripts/test-ts-loader.mjs ./scripts/test-static-mesh-construction.ts",
    "test:mesh-construction:open": "node ./scripts/run-static-mesh-construction-test.mjs --open"
  },
  "dependencies": {
    "lucide-react": "^0.372.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.163.0",
    "zustand": "^4.5.2",
    "@google/genai": "^1.34.0",
    "rc-dock": "^3.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/three": "^0.163.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.10"
  }
}
